# Copy to .env.local for local development. Never commit real values.
# Public (safe in app/web bundles)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only (Edge Function secrets / GitHub Actions secrets). Never in app or web code.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SECOND_MODEL_API_KEY=
AZURE_TTS_KEY=
AZURE_TTS_REGION=
SMS_GATEWAY_API_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
REVENUECAT_WEBHOOK_SECRET=
PAYHERE_MERCHANT_SECRET=
